# Lead-form email delivery (src/app/api/lead/route.ts).
# Copy this file to .env.local and fill in to start receiving submissions by email.
# Without RESEND_API_KEY the form still works — submissions are logged server-side.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Optional overrides:
# Where lead emails are delivered.
# LEAD_TO=sebastian@myrvold.marketing
# The From address. The domain must be verified in Resend.
# LEAD_FROM=Myrvold Marketing <leads@myrvold.marketing>
